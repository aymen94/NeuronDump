{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurondump.local/schemas/list.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "enum": [
              "ollama",
              "llama.cpp",
              "huggingface",
              "lmstudio",
              "dir",
              "file",
              "llama_cpp",
              "hugging_face",
              "lm_studio",
              "directory"
            ]
          },
          "architecture": {
            "type": [
              "string",
              "null"
            ]
          },
          "params": {
            "type": [
              "integer",
              "null"
            ]
          },
          "quantization": {
            "type": [
              "string",
              "null"
            ]
          },
          "context_length": {
            "type": [
              "integer",
              "null"
            ]
          },
          "size": {
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "has_projector": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "name",
          "source",
          "size",
          "path"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "schema_version",
    "models"
  ],
  "title": "neurondump list --json",
  "$defs": {
    "tensor_row": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "layer": {
          "type": [
            "integer",
            "null"
          ]
        },
        "role": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "dims": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "ggml_type": {
          "type": "string"
        },
        "n_elements": {
          "type": "integer"
        },
        "n_bytes": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "bits_per_weight": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "name",
        "dims",
        "ggml_type",
        "n_bytes",
        "offset"
      ]
    },
    "template_tree": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "syntax": {
          "enum": [
            "jinja",
            "go_template"
          ]
        },
        "source": {
          "type": "string"
        },
        "root": {
          "$ref": "#/$defs/template_node"
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "special_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisions": {
          "type": "integer"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "template_node": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "vars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "emits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/template_node"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "kind"
      ]
    },
    "lens": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "prob": {
          "type": "number"
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "text",
        "prob"
      ]
    }
  }
}